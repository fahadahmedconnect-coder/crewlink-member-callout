          "name": "Get Announcement (Seeded)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leadership/announcements/{{seededAnnouncementId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leadership", "announcements", "{{seededAnnouncementId}}", ""]

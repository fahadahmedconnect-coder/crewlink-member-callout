              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "Rule 2 - Check stats before (should be 2000)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Has 2000 recipients', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.total).to.equal(2000);",
                  "    pm.expect(jsonData.sent).to.equal(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leadership/announcements/{{seededAnnouncementId}}/stats/",
              "host": ["{{baseUrl}}"],

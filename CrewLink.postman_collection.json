    {
      "name": "Leadership",
      "item": [
        {
          "name": "List Announcements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/leadership/announcements/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leadership", "announcements", ""]
            }
          }
        },
        {
          "name": "Create Announcement",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.collectionVariables.set('newAnnouncementId', jsonData.id);",
                  "        console.log('Saved newAnnouncementId: ' + jsonData.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Meeting\",\n  \"body\": \"All members please attend the meeting at 6pm.\",\n  \"push_preview\": \"Meeting at 6pm - all members required\",\n  \"needs_ack\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leadership/announcements/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leadership", "announcements", ""]
            }
          }
        },
